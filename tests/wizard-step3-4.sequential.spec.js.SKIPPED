/**
 * Wizard Step 3 (Review) + Step 4 (Done) — single all-in-one test.
 * This was the right approach: one test that walks the full flow and runs
 * every assertion inline. test.setTimeout covers the whole run.
 *
 * Note: split from a per-test approach because reachStep3 takes >2min on the
 * deployed server, and per-test setups would take 22+ minutes.
 */
const { test, expect } = require('@playwright/test');
const path = require('node:path');
const fs = require('node:fs');
const { log } = require('./logger.js');

test.setTimeout(600000); // 10 min total

const PUBLIC_DIR = path.join(__dirname, '..', 'public');
const IMG_SMALL = path.join(PUBLIC_DIR, 'brayden-law-Io9wt6UKv28-unsplash.jpg');
const MY_TITLE = 'SeqTest ' + Date.now();
const MY_COMPANY = 'SeqCo-' + Date.now();

test.use({ storageState: 'state.json' });

test('Wizard Step 3 + Step 4 — full sequential walk with all assertions', async ({ page }) => {
  log.info('SEQ', '=== STARTING FULL WALK ===');

  // ─── Step 1 ───
  log.info('SEQ', 'navigating to /start/application');
  await page.goto('/start/application', { waitUntil: 'domcontentloaded', timeout: 120000 });
  await page.locator('h1').first().waitFor({ timeout: 60000 });
  const decline = page.getByRole('button', { name: /^Decline$/ });
  if (await decline.isVisible().catch(() => false)) await decline.click();
  log.info('SEQ', 'on step 1');

  const cb1 = page.getByRole('checkbox', { name: /18 years/i });
  const cb2 = page.getByRole('checkbox', { name: /country supported/i });
  if (!(await cb1.isChecked())) await cb1.check();
  if (!(await cb2.isChecked())) await cb2.check();
  await page.getByRole('combobox', { name: /^Primary Category/i }).selectOption({ label: 'Technology' });
  await page.waitForTimeout(500);
  const sub = page.getByRole('combobox', { name: /^Subcategory/i });
  const firstValid = await sub.locator('option').evaluateAll(opts => {
    const v = opts.find(o => o.value && !o.text.startsWith('Select'));
    return v ? v.value : null;
  });
  if (firstValid) await sub.selectOption(firstValid);
  await page.locator('#wiz-company').fill(MY_COMPANY);
  await page.locator('#wiz-address').fill('123 Test Street, Ahmedabad, GJ 380001');
  await page.locator('#cf-pan_card_number').fill('ABCDE1234F');
  await page.getByRole('button', { name: /^Continue$/ }).click();
  await expect(page.getByText(/Step 2 of 4/i)).toBeVisible({ timeout: 60000 });
  log.info('SEQ', 'on step 2');

  // ─── Step 2 ───
  await page.locator('#wiz-title').fill(MY_TITLE);
  await page.locator('#wiz-story').fill('This is a sequential test story comfortably longer than the 30-character minimum requirement.');
  await page.locator('#wiz-goal').fill('250000');
  if (fs.existsSync(IMG_SMALL)) {
    await page.locator('input[type=file][accept*="image"]').first().setInputFiles(IMG_SMALL);
    await page.locator('img[alt="Campaign cover"]').waitFor({ timeout: 90000 });
  }
  await page.waitForTimeout(500);
  await page.getByRole('button', { name: /^Continue$/ }).click();
  await expect(page.getByText(/Step 3 of 4/i)).toBeVisible({ timeout: 120000 });
  log.info('SEQ', 'on step 3');

  // ─── Step 3 assertions ───
  // S3-01-P
  await expect(page.getByRole('heading', { name: 'Review & Submit' })).toBeVisible();
  await expect(page.getByText(/Step 3 of 4/i)).toBeVisible();
  log.info('S3-01-P', 'pass: Review heading + step indicator');

  // S3-02-P
  const body3 = await page.locator('body').innerText();
  expect(body3).toContain(MY_TITLE);
  log.info('S3-02-P', 'pass: title reflected');

  // S3-03-P
  expect(body3).toMatch(/2,?50,?000/);
  log.info('S3-03-P', 'pass: funding goal reflected');

  // S3-04-P
  expect(body3).toContain(MY_COMPANY);
  log.info('S3-04-P', 'pass: company name reflected');

  // S3-05-P
  await expect(page.getByRole('button', { name: /Submit for Review/i })).toBeVisible();
  await expect(page.getByRole('button', { name: /^Back$/ })).toBeVisible();
  log.info('S3-05-P', 'pass: Submit + Back buttons present');

  // S3-06-N
  const inputsStep3 = await page.locator('input, textarea, select').count();
  expect(inputsStep3).toBe(0);
  log.info('S3-06-N', `pass: 0 inputs on step 3`);

  // S3-07-N
  const continueStep3 = await page.getByRole('button', { name: /^Continue$/ }).count();
  expect(continueStep3).toBe(0);
  log.info('S3-07-N', 'pass: no Continue button on step 3');

  // S3-08-N
  await page.getByRole('button', { name: /^Back$/ }).click();
  await expect(page.getByText(/Step 2 of 4/i)).toBeVisible({ timeout: 60000 });
  log.info('S3-08-N', 'pass: Back → step 2');
  // Navigate forward again
  await page.getByRole('button', { name: /^Continue$/ }).click();
  await expect(page.getByText(/Step 3 of 4/i)).toBeVisible({ timeout: 120000 });

  // ─── Step 4 ───
  await page.getByRole('button', { name: /Submit for Review/i }).click();
  await expect(page.getByText(/Step 4 of 4/i)).toBeVisible({ timeout: 120000 });
  log.info('S4-01-P', 'pass: on step 4');

  // S4-02-P
  await expect(page.getByText(/Submission received/i)).toBeVisible();
  const body4 = await page.locator('body').innerText();
  expect(body4).toMatch(/UNDER REVIEW|Under Review/);
  log.info('S4-02-P', 'pass: confirmation + Under Review visible');

  // S4-03-P
  const link = page.getByRole('link', { name: /Explore Campaigns/i });
  await expect(link).toBeVisible();
  const href = await link.getAttribute('href');
  expect(href).toContain('/explore');
  log.info('S4-03-P', `pass: Explore Campaigns → ${href}`);

  // S4-04-N
  const inputsStep4 = await page.locator('input, textarea, select').count();
  expect(inputsStep4).toBe(0);
  log.info('S4-04-N', 'pass: 0 inputs on step 4');

  log.info('SEQ', '=== ALL ASSERTIONS PASSED ===');
});
